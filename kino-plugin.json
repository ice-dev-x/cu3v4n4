{
  "id": "cuevana-3",
  "name": "Cuevana",
  "version": "2.8.5",
  "apiVersion": 6,
  "section": { "label": "CUEVANA" },
  "entry": "plugin.js",
  "description": "Películas y Series en LAT, ESP y SUB. Elija su idioma y servidor preferido en las configuraciones.",
  "author": "sadmachine",
  "streamHosts": "any",
  "hosts": [
    "cuevana3k.pro",
    "*.cuevana3k.pro",
    "filemoon.sx",
    "*.filemoon.sx",
    "lkhjerbhye3wjkhodvh5xiczuvd.lol",
    "*.lkhjerbhye3wjkhodvh5xiczuvd.lol",
    "lkhjerbhye3wjkhodvh5xlczuvd.lol",
    "*.lkhjerbhye3wjkhodvh5xlczuvd.lol",
    "dood.li",
    "*.dood.li",
    "dramiyos-cdn.com",
    "*.dramiyos-cdn.com",
    "swcdn.net",
    "*.swcdn.net",
    "luluvdo.com",
    "*.luluvdo.com",
    "acek-cdn.com",
    "*.acek-cdn.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "settings": [
    {
      "key": "idioma_pref",
      "label": "Idioma preferido",
      "type": "select",
      "default": "cualquiera",
      "options": [
        { "value": "cualquiera", "label": "El mejor disponible" },
        { "value": "latino", "label": "Español Latino" },
        { "value": "castellano", "label": "Castellano (España)" },
        { "value": "subtitulado", "label": "Subtitulado" }
      ]
    },
    {
      "key": "servidor_pref",
      "label": "Servidor preferido",
      "type": "select",
      "default": "3",
      "options": [
        { "value": "cualquiera", "label": "Automático" },
        { "value": "3", "label": "Nebula (Recomendado)" },
        { "value": "1", "label": "Hyper" },
        { "value": "2", "label": "Filemoon" },
        { "value": "4", "label": "Doodstream" }
      ]
    }
  ],
  "color": "#074a6e",
  "theme": {
    "accent": "#074a6e",
    "onAccent": "#FFFFFF",
    "background": "#074a6e",
    "surface": "#074a6e",
    "highlight": "#074a6e"
  },
  "icon": "icon.png"
}