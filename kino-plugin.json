{
  "id": "cuevana-3",
  "name": "Cuevana",
  "version": "2.3.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Películas y series en español",
  "author": "ice-dev-x",
  "hosts": [
    "cuevana3k.pro",
    "*.cuevana3k.pro",
    "filemoon.sx",
    "*.filemoon.sx",
    "lkhjerbhye3wjkhodvh5xiczuvd.lol",
    "*.lkhjerbhye3wjkhodvh5xiczuvd.lol",
    "lkhjerbhye3wjkhodvh5xlczuvd.lol",
    "*.lkhjerbhye3wjkhodvh5xlczuvd.lol",
    "dood.li",
    "*.dood.li",
    "dramiyos-cdn.com",
    "*.dramiyos-cdn.com",
    "swcdn.net",
    "*.swcdn.net",
    "luluvdo.com",
    "*.luluvdo.com",
    "acek-cdn.com",
    "*.acek-cdn.com"
  ],
  "capabilities": [
    "search",
    "scopedSearch",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "categories": [
    "movies",
    "series"
  ],
  "streamHosts": "any",
  "discoverable": true,
  "debug": false,
  "color": "#035453",
  "theme": {
    "accent": "#035453",
    "onAccent": "#FFFFFF",
    "background": "#0B1613",
    "surface": "#14302A",
    "highlight": "#F2C14E"
  },
  "settings": [
    {
      "key": "playback",
      "label": "Reproducción",
      "type": "section"
    },
    {
      "key": "servidor_pref",
      "label": "Servidor preferido",
      "type": "select",
      "default": "3",
      "options": [
        { "value": "1", "label": "Hyper" },
        { "value": "3", "label": "Nebula" },
        { "value": "cualquiera", "label": "Automático" }
      ]
    },
    {
      "key": "tools",
      "label": "Estado y Herramientas",
      "type": "section"
    },
    {
      "key": "state",
      "label": "Estado del servidor",
      "type": "status"
    },
    {
      "key": "clear",
      "label": "Borrar datos guardados",
      "type": "action",
      "confirm": "¿Deseas borrar la memoria temporal del plugin?"
    }
  ],
  "icon": "icon.png"
}